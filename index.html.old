<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Porra Quiniela LaLigaG ⚽ 1X2</title>
  <link rel="stylesheet" href="styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

  <!-- INDICADOR DE CARGA / SINCRONIZACIÓN -->
  <div id="sync-loader" class="sync-loader" style="display: none;">
    <div class="spinner"></div>
    <span id="sync-loader-text">Sincronizando con Google Sheets...</span>
  </div>

  <!-- PANTALLA / MODAL DE LOGIN -->
  <div id="auth-screen" class="auth-screen">
    <div class="auth-card card-glass">
      <div class="auth-header">
        <span class="logo-ball">⚽</span>
        <h2>Quiniela <span>LaLiga 1X2</span></h2>
        <p class="subtitle">Inicia sesión o regístrate para acceder a la porra</p>
      </div>

      <div class="auth-tabs">
        <button id="tab-login-btn" class="auth-tab-btn active">Iniciar Sesión</button>
        <button id="tab-register-btn" class="auth-tab-btn">Registrarse</button>
      </div>

      <!-- Formulario Login -->
      <form id="form-login" class="form-stacked mt-3">
        <div class="form-group">
          <label for="login-username">Usuario</label>
          <input type="text" id="login-username" class="form-input" placeholder="Tu nombre de usuario" required autocomplete="username">
        </div>
        <div class="form-group">
          <label for="login-password">Contraseña</label>
          <input type="password" id="login-password" class="form-input" placeholder="••••••••" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-primary btn-lg w-100 mt-3" id="btn-login-submit">⚽ Entrar a la Porra</button>
      </form>

      <!-- Formulario Registro -->
      <form id="form-register" class="form-stacked mt-3" style="display: none;">
        <div class="form-group">
          <label for="reg-username">Nombre de Usuario</label>
          <input type="text" id="reg-username" class="form-input" placeholder="Ej: pablo99" required autocomplete="username">
        </div>
        <div class="form-group">
          <label for="reg-name">Nombre / Apodo Visible</label>
          <input type="text" id="reg-name" class="form-input" placeholder="Ej: Pablo" required>
        </div>
        <div class="form-group">
          <label for="reg-avatar">Emoji / Avatar</label>
          <input type="text" id="reg-avatar" class="form-input" value="👤" maxlength="2">
        </div>
        <div class="form-group">
          <label for="reg-password">Contraseña</label>
          <input type="password" id="reg-password" class="form-input" placeholder="••••••••" required autocomplete="new-password">
        </div>
        <button type="submit" class="btn btn-success btn-lg w-100 mt-3" id="btn-reg-submit">✨ Crear Mi Cuenta</button>
      </form>

      <!-- Pista de credenciales demo -->
      <div class="auth-hint mt-3">
        <p><strong>🔑 Cuentas Iniciales:</strong></p>
        <p>👑 <strong>Admin:</strong> usuario: <code>admin</code> | clave: <code>admin123</code></p>
        <p>👤 O pulsa en <strong>Registrarse</strong> para crear tu usuario propio.</p>
      </div>
    </div>
  </div>

  <!-- APLICACIÓN PRINCIPAL (VISIBLE TRAS LOGIN) -->
  <div id="app-container" style="display: none; flex-direction: column; min-height: 100vh;">
    
    <!-- HEADER -->
    <header class="main-header">
      <div class="header-container">
        <div class="logo">
          <span class="logo-ball">⚽</span>
          <div>
            <h1>Quiniela <span>LaLiga 1X2</span></h1>
            <p class="subtitle">Pronósticos estilo 1X2 y clasificación</p>
          </div>
        </div>

        <div class="header-user-info">
          <div class="user-badge">
            <span id="header-user-avatar">👤</span>
            <div>
              <span id="header-user-name" class="user-badge-name">Usuario</span>
              <span id="header-user-role" class="user-badge-role">Jugador</span>
            </div>
          </div>
          <button id="btn-refresh-data" class="btn btn-outline btn-sm" title="Recargar datos desde Google Sheets">🔄 Actualizar</button>
          <button id="btn-export-wa" class="btn btn-whatsapp btn-sm">📱 Compartir Ranking</button>
          <button id="btn-logout" class="btn btn-danger-outline btn-sm">🚪 Salir</button>
        </div>
      </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="main-container">
      
      <!-- Navegación por pestañas -->
      <nav class="tabs-nav">
        <button class="tab-btn active" data-tab="tab-clasificacion">
          🏆 Clasificación General
        </button>
        <button class="tab-btn" data-tab="tab-pronosticos">
          ✍️ Mi Quiniela 1X2
        </button>
        <!-- Pestañas solo para Admin -->
        <button class="tab-btn admin-only" data-tab="tab-resultados" style="display: none;">
          🎯 Resultados Reales (Admin)
        </button>
        <button class="tab-btn admin-only" data-tab="tab-gestion" style="display: none;">
          ⚙️ Panel Administrador
        </button>
      </nav>

      <!-- TAB 1: CLASIFICACIÓN -->
      <section id="tab-clasificacion" class="tab-content active">
        <div class="card-glass">
          <div class="card-header">
            <div>
              <h2>🏆 Tabla de Clasificación</h2>
              <p class="text-muted">Aciertos 1X2 y puntos de la jornada actual</p>
            </div>
            <div class="jornada-badge">
              <span>Jornada LaLiga (1X2)</span>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table-ranking">
              <thead>
                <tr>
                  <th># Pos</th>
                  <th>Participante</th>
                  <th>Aciertos (Puntos)</th>
                  <th>Efectividad</th>
                  <th>Fallos</th>
                </tr>
              </thead>
              <tbody id="ranking-tbody">
                <!-- Renderizado dinámicamente -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Matriz de pronósticos -->
        <div class="card-glass mt-4">
          <h3>📊 Cuadro Comparativo de Quinielas</h3>
          <p class="text-muted">Pronóstico 1X2 de cada participante vs el resultado real de cada partido</p>
          <div class="table-responsive mt-3">
            <table class="table-matrix" id="matrix-table">
              <!-- Renderizado dinámico -->
            </table>
          </div>
        </div>
      </section>

      <!-- TAB 2: MI QUINIELA 1X2 (PRONÓSTICOS) -->
      <section id="tab-pronosticos" class="tab-content">
        <div class="card-glass">
          <div class="card-header">
            <div>
              <h2>✍️ Rellenar Mi Quiniela 1X2</h2>
              <p class="text-muted">Selecciona <strong>1</strong> (Gana local), <strong>X</strong> (Empate) o <strong>2</strong> (Gana visitante)</p>
            </div>
            <div class="quick-fill-box">
              <button id="btn-random-fill" class="btn btn-outline btn-sm">🎲 Relleno Aleatorio</button>
              <button id="btn-clear-my-preds" class="btn btn-outline btn-sm">🧹 Limpiar</button>
            </div>
          </div>

          <div id="quiniela-matches-list" class="quiniela-grid">
            <!-- Partidos estilo quiniela 1X2 -->
          </div>

          <div class="actions-footer">
            <button id="btn-save-pronosticos" class="btn btn-primary btn-lg">💾 Guardar Mi Quiniela</button>
          </div>
        </div>
      </section>

      <!-- TAB 3: RESULTADOS REALES (ADMIN) -->
      <section id="tab-resultados" class="tab-content">
        <div class="card-glass">
          <div class="card-header">
            <div>
              <h2>🎯 Resultados Reales Oficiales (Solo Administrador)</h2>
              <p class="text-muted">Establece el signo ganador (1, X o 2) de cada partido para calcular la clasificación</p>
            </div>
            <button id="btn-save-real-results" class="btn btn-success">✅ Actualizar y Calcular Puntos</button>
          </div>

          <div id="admin-results-list" class="quiniela-grid">
            <!-- Lista de partidos para seleccionar el resultado 1X2 real -->
          </div>
        </div>
      </section>

      <!-- TAB 4: PANEL ADMINISTRADOR -->
      <section id="tab-gestion" class="tab-content">
        <div class="grid-2-cols">
          <!-- Gestión de Partidos -->
          <div class="card-glass">
            <h3>🏟️ Añadir Partido a la Quiniela</h3>
            <p class="text-muted">Configura los partidos de la jornada</p>
            <form id="form-add-match" class="form-stacked mt-3">
              <div class="form-row">
                <div class="form-group">
                  <label for="match-local">Equipo Local (1)</label>
                  <input type="text" id="match-local" class="form-input" placeholder="Ej: Real Madrid" required>
                </div>
                <div class="form-group">
                  <label for="match-visitor">Equipo Visitante (2)</label>
                  <input type="text" id="match-visitor" class="form-input" placeholder="Ej: Barcelona" required>
                </div>
              </div>
              <div class="form-group">
                <label for="match-date">Fecha / Horario</label>
                <input type="text" id="match-date" class="form-input" placeholder="Ej: Sábado 21:00">
              </div>
              <button type="submit" class="btn btn-primary">➕ Añadir Partido</button>
            </form>

            <div class="mt-4">
              <h4>Partidos Actuales (<span id="matches-count">0</span>)</h4>
              <ul id="admin-matches-manage-list" class="users-list mt-3">
                <!-- Lista de partidos para borrar -->
              </ul>
            </div>
          </div>

          <!-- Gestión de Usuarios y Conexión -->
          <div class="card-glass">
            <h3>👥 Gestión de Participantes (<span id="user-count">0</span>)</h3>
            <p class="text-muted">Lista de jugadores registrados en la porra</p>
            <ul id="users-list" class="users-list mt-3">
              <!-- Lista de usuarios -->
            </ul>

            <div class="admin-danger-box mt-4">
              <h4>⚙️ Acciones Globales</h4>
              <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 0.75rem;">Cargar partidos demo en Google Sheets</p>
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <button id="btn-admin-demo" class="btn btn-outline btn-sm">🔄 Cargar Partidos Demo</button>
              </div>
            </div>
          </div>
        </div>
      </section>

    </main>

    <!-- Toast Notification -->
    <div id="toast" class="toast">Mensaje</div>

    <footer class="main-footer">
      <p>Porra Quiniela LaLiga 1X2 • Conectado con Google Sheets & GitHub Pages</p>
    </footer>
  </div>

  <script src="app.js"></script>
</body>
</html>
